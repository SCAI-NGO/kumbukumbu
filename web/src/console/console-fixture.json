{
  "allowed": ["ls", "cat", "outline", "rg", "semsearch", "img", "pdf", "links", "backlinks", "tags", "board", "head", "tail", "wc", "sort", "history", "diff", "trash", "lscp", "uname", "help"],
  "refused": ["restore", "mv", "mkdir", "rm", "mkcp", "rmcp"],
  "lines": [
    { "line": "", "stages": [] },
    { "line": "   ", "stages": [] },
    { "line": "ls", "stages": [["ls"]] },
    { "line": "ls /Work/notes", "stages": [["ls", "/Work/notes"]] },
    { "line": "cat \"a b.md\"", "stages": [["cat", "a b.md"]] },
    { "line": "echo 'single \"x\"'", "stages": [["echo", "single \"x\""]] },
    { "line": "echo \"double \\\"x\\\" \\\\ y\"", "stages": [["echo", "double \"x\" \\ y"]] },
    { "line": "echo \"a\\nb\"", "stages": [["echo", "a\\nb"]] },
    { "line": "cat a\\ b", "stages": [["cat", "a b"]] },
    { "line": "cat a\\\\b", "stages": [["cat", "a\\b"]] },
    { "line": "cat a\\", "stages": [["cat", "a\\"]] },
    { "line": "rg 'a|b' /x", "stages": [["rg", "a|b", "/x"]] },
    { "line": "a | b | c", "stages": [["a"], ["b"], ["c"]] },
    { "line": "a|b", "stages": [["a"], ["b"]] },
    { "line": "echo \"|\"", "stages": [["echo", "|"]] },
    { "line": "ls\t/x", "stages": [["ls", "/x"]] },
    { "line": "  ls   /x  ", "stages": [["ls", "/x"]] },
    { "line": "cat /Gärten/Bewässerung.md", "stages": [["cat", "/Gärten/Bewässerung.md"]] },
    { "line": "echo ''", "stages": [["echo", ""]] },
    { "line": "a > b", "refused": true },
    { "line": "a && b", "refused": true },
    { "line": "a ; b", "refused": true },
    { "line": "a `b`", "refused": true },
    { "line": "$(a)", "refused": true },
    { "line": "${a}", "refused": true },
    { "line": "a || b", "refused": true },
    { "line": "| a", "refused": true },
    { "line": "a |", "refused": true },
    { "line": "\"open", "refused": true },
    { "line": "'open", "refused": true },
    { "line": "a\nb", "refused": true },
    { "line": "a\\\nb", "refused": true }
  ]
}
