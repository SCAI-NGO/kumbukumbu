{
  "name": "kumbu-web",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p e2e && vite build",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "preview": "vite preview",
    "test:diagrams": "playwright test -c e2e/diagrams/playwright.config.ts",
    "e2e": "e2e/stack/run.sh",
    "e2e:0.5.0": "e2e/stack/run.sh --grep \"@smoke|@calendar|@flags|@explorer|@recent|@mermaid|@embeds|@aliases|@ailink|@blockrefs|@mentions|@photo|@properties\"",
    "e2e:0.6.0": "e2e/stack/run.sh --grep \"@smoke|@memory|@graph|@svg|@deeplinks|@upload|@publish|@blame|@files|@readers|@shell|@palette|@windows|@filters|@console|@workspace|@calendar\"",
    "gen:api": "openapi-typescript ${KUMBU_OPENAPI_URL:-http://localhost:8083/api/openapi.json} -o src/api/schema.d.ts",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-query": "^5.106.1",
    "d3-force": "^3.0.1",
    "fflate": "0.8.3",
    "katex": "^0.19.1",
    "lucide-react": "^1.70.0",
    "mermaid": "^11.17.2",
    "openapi-fetch": "^0.17.0",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "~1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
