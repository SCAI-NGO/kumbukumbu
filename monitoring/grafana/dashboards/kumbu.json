      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kumbu-prometheus"
          },
          "expr": "sum by (code) (increase(http_requests_received_total{code=~\"4xx|5xx\"}[1h]))",
          "legendFormat": "{{code}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "kumbu-prometheus"
          },
          "expr": "sum by (endpoint) (increase(kumbu_http_rate_limited_total[1h]))",
          "legendFormat": "429 {{endpoint}}",
          "range": true
        }
      ],
      "description": "Requests answered 4xx or 5xx, and those answered 429 by route template, in the hour before each point."
    },
