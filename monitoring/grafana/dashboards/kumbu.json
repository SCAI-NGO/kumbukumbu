    {
      "type": "timeseries",
      "id": 2,
      "title": "HTTP requests by endpoint",
      "datasource": {
        "type": "prometheus",
        "uid": "kumbu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kumbu-prometheus"
          },
          "expr": "sum by (endpoint) (rate(http_requests_received_total[5m]))",
          "legendFormat": "{{endpoint}}",
          "range": true
        }
      ],
      "description": "Requests per second by route template; the path itself is never a label."
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "HTTP p95 latency by endpoint",
      "datasource": {
        "type": "prometheus",
        "uid": "kumbu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kumbu-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket{endpoint!=\"/api/ws\"}[5m]) unless rate(http_request_duration_seconds_bucket{endpoint=~\"/mcp.*\",method=\"GET\"}[5m])))",
          "legendFormat": "{{endpoint}}",
          "range": true
        }
      ],
      "description": "Without the long-lived streams (the sync socket /api/ws and the MCP event stream, GET on /mcp), which last as long as the client stays connected."
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "HTTP errors and rate limits per hour",
      "datasource": {
        "type": "prometheus",
        "uid": "kumbu-prometheus"
