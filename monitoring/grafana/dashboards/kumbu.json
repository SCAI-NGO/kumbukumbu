    {
      "type": "timeseries",
      "id": 2,
      "title": "HTTP requests by endpoint",
      "datasource": {
        "type": "prometheus",
        "uid": "kumbu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kumbu-prometheus"
          },
          "expr": "sum by (endpoint) (rate(http_requests_received_total[5m]))",
          "legendFormat": "{{endpoint}}",
          "range": true
