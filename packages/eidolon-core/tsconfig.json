{
  // The core's own code sees the language and src/globals.d.ts, nothing else: no DOM, no Node. Whatever the host
  // provides (storage, crypto keys, HTTP, the clock, the WebSocket) comes in through a port (design §2a).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
