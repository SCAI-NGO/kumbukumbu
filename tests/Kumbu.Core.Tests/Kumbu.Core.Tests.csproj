<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Search/tokenizer-reference.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Search/tokenizer-reference-arctic-l.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shared with the web's tests, which find it beside them: the Docker web stage copies only web/. -->
    <None Include="../../web/src/note/comments.cases.json" Link="Publishing/comments.cases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Kumbu.Core/Kumbu.Core.csproj" />
  </ItemGroup>

</Project>
