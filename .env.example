# Required by this compose.yaml (the server itself runs without one, and then the dev token opens nothing).
# At least 16 characters; generate one with: openssl rand -hex 32
KUMBU_DEV_TOKEN=

# Optional. The address users reach this server at: scheme, host and port, no path. Invitation links are
# built from it, and `docker compose exec kumbu kumbu bootstrap-admin` refuses to run without it.
# KUMBU_PUBLIC_URL=http://localhost:8080

# Optional. Folder whose subfolders are your vaults (default ./vaults). Use a real path:
# symlinked folders inside ./vaults do not resolve inside the container.
# KUMBU_VAULTS=/home/me/Notes

# Optional. MongoDB image (default mongo:8). MongoDB 8.x refuses to start on Linux kernels
# 6.19–7.0.13; on such a kernel use mongo:7.0.
# KUMBU_MONGO_IMAGE=mongo:7.0

# Optional. Host port the server is published on, localhost only (default 8080).
# KUMBU_PORT=8083

# Optional. Named checkpoints (mkcp) a vault keeps at most (default 10). Each one holds the content of
# its notes as they were, so more checkpoints take more space in the database.
# KUMBU_CHECKPOINT_LIMIT=10

# Optional. Search by meaning (semsearch). On the first start the server downloads the embedding model
# (about 630 MB, checked against its SHA-256) into the models volume; set false to skip it. semsearch then
# ranks by words only.
# KUMBU_SEARCH=false

# Optional. The embedding model: arctic-m (default; 613 MB, about 1 GB of memory, about 26 ms per section) or
# arctic-l (1.13 GB, about 2 GB of memory, about 49 ms per section, finer results). Each is downloaded once
# into the models volume. Switching re-embeds every note when its vault is next unlocked.
# KUMBU_SEARCH_MODEL=arctic-m

# Optional. After changing KUMBU_DEV_TOKEN: the vaults' recovery keys (comma-separated). The next start
# gives the new token access to their vaults; remove them from this file afterwards.
# KUMBU_RECOVERY_KEYS=kumbu-rk-....

# Optional. Behind a reverse proxy such as Traefik that is the server's only way in: take the client IP
# (for rate limits on wrong keys) from X-Forwarded-For. Leave it off while the port is published directly.
# Needs KUMBU_PUBLIC_URL as well: without it the server refuses to start.
# KUMBU_TRUSTED_PROXY=true
