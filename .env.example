# Optional. Without one the dev token opens nothing and seeding is skipped: what a public instance wants, where
# users and API keys open the vaults. For a single-user setup or the sample vaults, at least 16 characters;
# generate one with: openssl rand -hex 32
KUMBU_DEV_TOKEN=

# Optional. The address users reach this server at: scheme, host and port, no path. Invitation links are
# built from it, and `docker compose exec kumbu kumbu bootstrap-admin` (prints the link that creates the
# first admin) refuses to run without it.
# KUMBU_PUBLIC_URL=http://localhost:8080

# Optional. Folder whose subfolders are your vaults (default ./vaults). Use a real path:
# symlinked folders inside ./vaults do not resolve inside the container.
# KUMBU_VAULTS=/home/me/Notes

# Optional. MongoDB image (default mongo:8). MongoDB 8.x refuses to start on Linux kernels
# 6.19–7.0.13; on such a kernel use mongo:7.0.
# KUMBU_MONGO_IMAGE=mongo:7.0

# Optional. MongoDB authentication: set, MongoDB requires a login and the server signs in as `kumbu` with this
# password; the first start with it creates the key file and the user (also on an existing data volume, see the
# README). Unset, MongoDB runs without authentication. Generate one with: openssl rand -hex 32
# KUMBU_MONGO_PASSWORD=3f1c9e0a7b5d4e2f8a6c1b0d9e7f5a3c2b1d0e9f8a7c6b5d4e3f2a1b0c9d8e7f
# To keep it out of the containers' environment, use a Docker secret instead (Kumbu__Mongo__PasswordFile and
# KUMBU_MONGO_PASSWORD_FILE in a compose.override.yaml, see the README) and leave this unset.

# Optional. Host port the server is published on, localhost only (default 8080).
# KUMBU_PORT=8083

# Optional. Named checkpoints (mkcp) a vault keeps at most (default 10). Each one holds the content of
# its notes as they were, so more checkpoints take more space in the database.
# KUMBU_CHECKPOINT_LIMIT=10

# Optional. Lifetime of an app connection's access token in minutes (default 60, 5 to 1440). Shorter means
# more refreshes; claude.ai shows 'Reconnect' if a refresh fails.
# KUMBU_OAUTH_ACCESS_TOKEN_MINUTES=60

# Optional. Your privacy contact (an address or a name). An admin who deletes a user for a privacy request gets
# a reply to copy, signed with it; unset, the reply leaves a placeholder to fill in.
# KUMBU_PRIVACY_CONTACT=privacy@example.org

# Optional. Search by meaning (semsearch). On the first start the server downloads the embedding model
# (about 630 MB, checked against its SHA-256) into the models volume; set false to skip it. semsearch then
# ranks by words only.
# KUMBU_SEARCH=false

# Optional. The embedding model: arctic-m (default; 613 MB, about 1 GB of memory, about 26 ms per section) or
# arctic-l (1.13 GB, about 3 GB of memory, about 49 ms per section, finer results). Each is downloaded once
# into the models volume. Switching re-embeds every note when its vault is next unlocked.
# KUMBU_SEARCH_MODEL=arctic-m

# Optional. External embedding providers (e.g. TensorX) that vault owners may opt in to, per vault: then the text of
# every section and every search query of that vault goes to the provider. They are not set here: each provider is a
# group of Kumbu__Embeddings__Providers__<name>__… settings plus its API key as a Docker secret (a file, never the key
# in this file), in a compose.override.yaml. See README, "External embedding providers", for a TensorX example.
# KUMBU_SEARCH=false switches off the internal model only; opted-in vaults keep searching by meaning.

# Optional. The embedding provider of every vault whose owner never chose one: internal (default) or the name of one
# of the external providers above. Set to an external one, the text of those vaults goes there without their owners
# opting in (they can switch back to internal in the web app). An unknown name keeps the server from starting.
# KUMBU_EMBEDDINGS_DEFAULT=tensorx

# Optional. After changing KUMBU_DEV_TOKEN: the vaults' recovery keys (comma-separated). The next start
# gives the new token access to their vaults; remove them from this file afterwards.
# KUMBU_RECOVERY_KEYS=kumbu-rk-....

# Optional. Behind a reverse proxy such as Traefik that is the server's only way in from outside the host: take the
# client IP (for rate limits on wrong keys) from X-Forwarded-For. Every peer is trusted, the other containers on the
# server's networks too (README, "Behind Traefik"). Leave it off while the port is published directly.
# Needs KUMBU_PUBLIC_URL as well: without it the server refuses to start. compose.traefik.yaml sets both itself.
# KUMBU_TRUSTED_PROXY=true

# Behind Traefik (compose.traefik.yaml, README "Behind Traefik"): the host name Kumbu² is reached at, with a DNS
# record pointing at this machine. Required with that file, which then sets KUMBU_PUBLIC_URL to https://<host> and
# KUMBU_TRUSTED_PROXY to true itself, and publishes no port for the server (KUMBU_PORT is not used).
# KUMBU_HOST=kumbu.example.org

# Optional, with compose.traefik.yaml. An e-mail address for Let's Encrypt (the account the certificates belong to).
# KUMBU_ACME_EMAIL=admin@example.org

# Optional, with compose.traefik.yaml. The ACME directory (default Let's Encrypt's). For a first try, its staging
# directory issues untrusted certificates without counting against the production rate limits. Once it works, remove
# the line and the staging certificate: `docker compose down`, `docker volume rm <project>_letsencrypt`, up again.
# KUMBU_ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Optional, with compose.traefik.yaml. The Traefik image (default traefik:v3.7).
# KUMBU_TRAEFIK_IMAGE=traefik:v3.7

# With compose.monitoring.yaml (README, "Monitoring"): Grafana's admin password. Required with that file, which refuses
# to start without it; not used otherwise. Generate one with: openssl rand -hex 24
# Append :compose.monitoring.yaml to COMPOSE_FILE (at the end of this file) so that every `docker compose` command
# includes it: the file also puts the server on the monitoring network, and an `up -d` or `pull` without it takes the
# server off it, so Prometheus loses its target. With direnv, .envrc exports COMPOSE_FILE and wins over this file:
# append it to the export line in .envrc instead, then `direnv allow`.
# KUMBU_GRAFANA_ADMIN_PASSWORD=

# Optional, with compose.monitoring.yaml. Host port Grafana is published on, localhost only (default 3000); reach it
# through an SSH tunnel: ssh -L 3000:127.0.0.1:3000 user@host
# KUMBU_GRAFANA_PORT=3000

# Optional, with compose.monitoring.yaml. Only with Grafana behind a reverse proxy: the address it is reached at.
# Its login page is then on the internet, guarded by the admin password alone.
# KUMBU_GRAFANA_ROOT_URL=https://grafana.example.org/

# Optional. The server image (default ghcr.io/scai-ngo/kumbukumbu:latest, which moves only on a release).
# Pin a version, e.g. ghcr.io/scai-ngo/kumbukumbu:0.1.0.
# KUMBU_IMAGE=ghcr.io/scai-ngo/kumbukumbu:latest

# Optional. Build the image from this checkout instead of pulling the published one: `docker compose up --build`
# then works as in the Quickstart. direnv sets this through .envrc; this line is for everyone else.
# COMPOSE_FILE=compose.yaml:compose.build.yaml
# Behind Traefik, so that every `docker compose` command (exec, logs, pull) includes compose.traefik.yaml:
# COMPOSE_FILE=compose.yaml:compose.traefik.yaml
# With monitoring (README, "Monitoring"), append it: compose.yaml:compose.monitoring.yaml, or behind Traefik
# COMPOSE_FILE=compose.yaml:compose.traefik.yaml:compose.monitoring.yaml
# (with direnv, in .envrc's export line instead: a COMPOSE_FILE in the shell wins over this file)
